# Goose-backed local SQL stores.
TIMESCALE_URL=postgres://tracking:tracking@localhost:5433/tracking?sslmode=disable
VALKEY_PASSWORD=
# R2 is preferred for interactive story HTML. The public base URL must expose
# the same bucket/prefix; Bunny remains a local/fallback upload provider.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
R2_PUBLIC_BASE_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# mobile_push background worker. ENCRYPTION_KEY (shared with clashking-api)
# decrypts mobile_push_devices tokens unless MOBILE_PUSH_TOKEN_KEY overrides it.
ENCRYPTION_KEY=
MOBILE_PUSH_APNS_BEARER_TOKEN=
MOBILE_PUSH_APNS_BUNDLE_ID=
# Preferred: configure Application Default Credentials. Locally, run
# `gcloud auth application-default login`; in Docker mount the resulting ADC
# file and point this variable at its container path. Tokens auto-refresh.
GOOGLE_APPLICATION_CREDENTIALS=
MOBILE_PUSH_FCM_PROJECT_ID=
# Coolify/non-Google hosting alternative: store the complete service-account
# JSON as a locked, multiline, runtime-only environment variable.
MOBILE_PUSH_FCM_SERVICE_ACCOUNT_JSON=
# Optional legacy/testing override; normally leave empty when ADC is enabled.
MOBILE_PUSH_FCM_BEARER_TOKEN=
