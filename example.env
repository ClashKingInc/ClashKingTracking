# Shared Timescale connection
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=clashking
TIMESCALE_USERNAME=clashking
TIMESCALE_PASSWORD=replace_me
TIMESCALE_SSLMODE=disable

# Shared Valkey connection
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=replace_me

# ClashKing service origins. Origins never include /v1.
CLASHKING_PROXY_INTERNAL_ORIGIN=http://clashking-proxy:8011
CLASHKING_API_ORIGIN=https://api.clashk.ing
CLASHKING_API_TOKEN=

# Scheduled army-family naming through Workers AI behind AI Gateway.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=clashking
CLOUDFLARE_AI_API_TOKEN=
# Loopback-only test override; production uses https://api.cloudflare.com/client/v4.
CLASHKING_LOCAL_CLOUDFLARE_AI_API_ORIGIN=

# Reddit worker
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Mobile push. Reuse the API's production data-encryption key.
DATA_ENCRYPTION_KEY=
MOBILE_PUSH_FCM_PROJECT_ID=clashking-prod
MOBILE_PUSH_FCM_SERVICE_ACCOUNT_JSON=

# Discord gateway cache writer. Dev and prod deployments use different tokens.
DISCORD_BOT_TOKEN=
DISCORD_MESSAGE_CREATE_ENABLED=true
